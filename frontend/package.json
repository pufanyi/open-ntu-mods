{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 5173",
    "build": "ng build",
    "preview": "ng serve --configuration production --host 0.0.0.0 --port 4173",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/generated/api-types.ts",
    "typecheck": "ng build --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^21.2.15",
    "@angular/compiler": "^21.2.15",
    "@angular/core": "^21.2.15",
    "@angular/forms": "^21.2.15",
    "@angular/platform-browser": "^21.2.15",
    "@angular/platform-browser-dynamic": "^21.2.15",
    "@angular/router": "^21.2.15",
    "marked": "^18.0.4",
    "openapi-fetch": "^0.15.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.2",
    "jsdom": "^27.2.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
