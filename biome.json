{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.git",
      "!.jj",
      "!target",
      "!backend/target",
      "!frontend/dist",
      "!frontend/src/generated/api-types.ts",
      "!node_modules"
    ]
  }
}
