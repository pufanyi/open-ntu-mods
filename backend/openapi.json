  "components": {
    "schemas": {
      "Course": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "archived",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "au": {
            "type": ["integer", "null"],
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "school": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CourseOffering": {
        "type": "object",
        "required": [
          "id",
          "course_id",
          "academic_year",
          "semester",
